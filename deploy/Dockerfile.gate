# Render-specific image for SmartPort-X gate service.
# Build context must be the repository root.
FROM maven:3.9.16-eclipse-temurin-25 AS builder
WORKDIR /workspace
COPY . .
RUN mvn -B -DskipTests package

FROM eclipse-temurin:25-jre
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl postgresql-client \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY deploy/init-schema.sh /app/init-schema.sh
RUN chmod +x /app/init-schema.sh
COPY --from=builder /workspace/smartportx-gate/target/smartportx-gate-*.jar app.jar
EXPOSE 8083
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
