# =============================================================================
# SmartPortX — Environment Variables (M1.4)   [DEPLOYMENT-ARCHITECTURE §5.2]
# Copy to `.env` and customize. `.env` is gitignored — never commit real secrets.
# =============================================================================

# --- Database ----------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=smartportx
POSTGRES_USER=smartportx
DB_PASSWORD=smartportx_local

# --- RabbitMQ ----------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_ADMIN_USERNAME=smartportx_admin
RABBITMQ_ADMIN_PASSWORD=smartportx_admin_local_change_me
RABBITMQ_USERNAME=smartportx_app
RABBITMQ_PASSWORD=smartportx_app_local_change_me

# --- JWT (identity + gateway) -------------------------------------------------
# RS256 signing key; >= 2048-bit (Architecture §9.3). Local dev fallback only.
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800

# --- Seed data ----------------------------------------------------------------
# Demo users in identity; customer testimonials in notification.
# Set to false to skip seeding on first boot.
SEED_DEMO_USERS=true
SEED_TESTIMONIALS=true

# --- Integration Service ------------------------------------------------------
IOT_MODE=simulation
SIM_CONTAINER_COUNT=50
SIM_TICK_INTERVAL=30
CUSTOMS_CLEARANCE_RATE=0.7
RETRY_MAX_ATTEMPTS=3

# --- Monitoring ---------------------------------------------------------------
GRAFANA_PASSWORD=admin