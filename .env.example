# =============================================================================
# SMART PORTICS / SmartPortX — Docker environment template
#
# Copy to `.env` in the repository root and replace EVERY placeholder.
# `.env` is gitignored (.gitignore line 28) and must never be committed.
# Compose intentionally fails fast when a required variable is missing/empty.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev

# --- PostgreSQL ---------------------------------------------------------------
# Database and bootstrap (superuser) role. The bootstrap role is used only by
# PostgreSQL init; applications connect with the dedicated APP_ROLE below.
POSTGRES_DB=smartportx
POSTGRES_USER=smartportx
# Temporary host port (5433) avoids conflict with a native PostgreSQL instance.
POSTGRES_PORT=5433
# Strong, unique value; never a development default.
DB_PASSWORD=REPLACE_WITH_RANDOM_64_HEX_CHARS
# Least-privilege login role created by scripts/init-databases.sh.
APP_ROLE=smartportx_app
APP_ROLE_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_64_HEX_CHARS
DATABASE_USERNAME=smartportx_app

# --- RabbitMQ -----------------------------------------------------------------
RABBITMQ_USERNAME=smartportx
RABBITMQ_PASSWORD=REPLACE_WITH_RANDOM_64_HEX_CHARS

# --- Eureka dashboard basic auth ----------------------------------------------
# /eureka/** registration and /actuator/health remain permitAll.
SMARTPORTX_EUREKA_SECURITY_USERNAME=admin
SMARTPORTX_EUREKA_SECURITY_PASSWORD=REPLACE_WITH_RANDOM_64_HEX_CHARS

# --- JWT ----------------------------------------------------------------------
# NOTE: identity uses ephemeral RS256 keys locally; JWT_SECRET is legacy config
# retained only for compatibility with the validator script.
JWT_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARS

# --- Seed data ----------------------------------------------------------------
SEED_DEMO_USERS=true
SEED_TESTIMONIALS=true

# --- Dashboard ----------------------------------------------------------------
# Host port for the React/Vite + nginx frontend (container internally uses 3000).
DASHBOARD_PORT=3100
# Exact browser origins allowed to open the STOMP/SockJS handshake.
SMARTPORTX_WEBSOCKET_ALLOWED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

# --- Network trust boundaries --------------------------------------------------
SMARTPORTX_TRUSTED_PROXY_NETWORKS=172.16.0.0/12
SMARTPORTX_MONITORING_ALLOWED_NETWORKS=127.0.0.1/32,::1/128,172.16.0.0/12

# --- Integration service -------------------------------------------------------
IOT_MODE=simulation
SIM_CONTAINER_COUNT=50
SIM_TICK_INTERVAL=30
CUSTOMS_CLEARANCE_RATE=0.7
RETRY_MAX_ATTEMPTS=3

# --- Monitoring ---------------------------------------------------------------
GRAFANA_PASSWORD=REPLACE_WITH_RANDOM_64_HEX_CHARS
