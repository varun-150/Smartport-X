{
  "name": "smartportx-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SmartPortX operational dashboard - React 18 + TypeScript, wired to the live SmartPortX backend (gateway REST + STOMP).",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
